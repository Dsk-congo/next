rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Données du site NextGenIT (une collection à part).
    // Version de test, ouverte comme le site DSK : à renforcer avant l'ouverture au public.
    match /nextgenit/{cle} {
      allow read, write: if true;
    }
    // Fichiers des cours (PDF, images) de moins de 700 Ko
    match /nextgenit_fichiers/{cle} {
      allow read, write: if true;
    }
  }
}
